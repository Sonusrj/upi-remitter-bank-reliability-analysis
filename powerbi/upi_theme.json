{
  "name": "UPI Reliability",
  "dataColors": ["#0072B2", "#D55E00", "#E69F00", "#009E73", "#56B4E9", "#9AA5B1", "#CC79A7", "#F0E442"],
  "background": "#FFFFFF",
  "foreground": "#1F2933",
  "tableAccent": "#0072B2",
  "textClasses": {
    "title":   { "fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#1F2933" },
    "header":  { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1F2933" },
    "label":   { "fontFace": "Segoe UI", "fontSize": 10, "color": "#52606D" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 28, "color": "#1F2933" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E4E7EB" } }, "radius": 8 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#1F2933" } }, "fontSize": 12, "fontFamily": "Segoe UI Semibold", "alignment": "left" }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F7F8FA" } }, "transparency": 0 }]
      }
    }
  }
}
